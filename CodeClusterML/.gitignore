# ── Virtual Environment ───────────────────────────────────────────
venv/
.venv/
env/

# ── Model Weights (large binary files) ───────────────────────────
weights/
*.pt
*.pth
*.onnx
*.bin
*.pkl
*.h5

# ── Python Cache ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Environment & Secrets ─────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
*.key

# ── InsightFace / Torch downloaded models ─────────────────────────
# These auto-download at runtime — no need to commit
.insightface/
*.cache/
~/.insightface/

# ── Candidate registration images (PII) ───────────────────────────
*.jpg
*.jpeg
*.png

# ── IDE & Editor ──────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# ── OS Junk ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Temp ───────────────────────────────────────────────────
*.log
*.tmp
*.temp
logs/

# ── Build & Distribution ──────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Test & Coverage Artifacts ─────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Jupyter Notebooks ─────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb



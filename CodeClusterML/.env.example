# ── ML Worker ────────────────────────────────────────────────────────────────
# Port the gRPC server listens on. Java backend must connect to this port.
GRPC_PORT=50051

# ── Head Pose ─────────────────────────────────────────────────────────────────
# Yaw/pitch angle (degrees) beyond which a head-turn violation is flagged.
HEAD_YAW_THRESHOLD_DEG=30.0
HEAD_PITCH_THRESHOLD_DEG=20.0

# ── Gaze ──────────────────────────────────────────────────────────────────────
# Seconds of continuous off-screen gaze before a violation is raised.
GAZE_OFF_SCREEN_THRESHOLD_SEC=3.0

# ── Object Detection ──────────────────────────────────────────────────────────
# YOLO detection confidence cutoff (0.0–1.0).
YOLO_CONFIDENCE_THRESHOLD=0.65

# ── Spectacles Detection ──────────────────────────────────────────────────────
# ONNX classifier confidence cutoff (0.0–1.0).
SPECS_CONFIDENCE_THRESHOLD=0.50

# ── Face Authentication ───────────────────────────────────────────────────────
# InsightFace cosine similarity threshold. Scores below this are rejected.
# Typical webcam JPEG range: 0.78–0.82 for a match.
FACE_MATCH_THRESHOLD=0.72

# ── Face Counter ──────────────────────────────────────────────────────────────
# Seconds a face must be absent before a "no face" violation is raised.
FACE_MISSING_THRESHOLD_SEC=5.0

# ── Speech Detection ──────────────────────────────────────────────────────────
# Silero VAD confidence cutoff (0.0–1.0).
SPEECH_CONFIDENCE_THRESHOLD=0.50

# ── Database (used by Java backend, not ML worker) ────────────────────────────
POSTGRES_PASSWORD=changeme
